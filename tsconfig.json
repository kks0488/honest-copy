    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "strict": true, "noEmit": true, "allowJs": true,
    "skipLibCheck": true, "types": ["vite/client", "node"]
